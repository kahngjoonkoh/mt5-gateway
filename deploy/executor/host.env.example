# Per-host settings, read by install.sh, push.sh and the systemd units. Copy to ~/mt5gw/host.env.
# Plain KEY=value lines (systemd EnvironmentFile and sh both read it): no spaces around =.
# The broker's MT5 install folder inside the Wine prefix
MT5_DIR="/home/USER/.mt5/drive_c/Program Files/BROKER MT5"
# The broker's MT5 installer (install.sh only)
MT5_SETUP_URL="https://download.mql5.com/cdn/web/BROKER/mt5/BROKER5setup.exe"
# Part of the terminal's window title, for mt5-allowlist.sh
MT5_WINDOW="BROKER-MT5"
# Where the bots' HTTP API listens. 127.0.0.1 = SSH tunnel only; 0.0.0.0 to serve a private network
MT5GW_LISTEN="127.0.0.1:8000"
# install.sh opens port 8000 to this range when set, e.g. your private subnet
MT5GW_ALLOW_CIDR=""
